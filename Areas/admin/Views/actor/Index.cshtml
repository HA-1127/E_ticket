@model IEnumerable<Actor>
@section Scripts {

    @if (@TempData["successfull notification"] is not null)
    {
        <script>
            toastr.success('@TempData["successfull notification"]')
        </script>
    }
    else if (TempData["successfull notification"] is not null)
    {
        <script>
            toastr.success('@TempData["successfull notification"]')
        </script>
    }
}


<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">All Actors</h2>
        </div>
        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
            <a href="/admin/actor/Create" class="btn btn-success">Create</a>
        </div>
    </div>
    <!-- Filter Section -->
    <section class="py-3 filter-bar">
        <div class="container">
            <div class="row" style="background-color: rgba(var(--bs-light-rgb), var(--bs-bg-opacity)) !important;">
                <div class="col-12">
                    <form>
                        <div class="row">
                            <!-- first Name -->
                            <div class="col-md-3">
                                <input type="text" class="form-control" placeholder="last Name" name="LastName" value="@ViewBag.actorfristName">
                            </div>
                            <!-- first Name -->
                            <div class="col-md-3">
                                <input type="text" class="form-control" placeholder="first Name" name="FirstName" value="@ViewBag.actorlastName">
                            </div>

                            <!-- Submit Button -->
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-dark w-100">Filter</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <div class="row">
        <div class="col-12">

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">First Name</th>
                        <th scope="col">Last Name</th>
                        <th scope="col"> Bio</th>

                        <th scope="col">News</th>




                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>

                            <td>@item.Bio</td>

                            <td>@item.News</td>




                            <td>
                                <a href="/movies/Home/Details/@item.Id" type="button" class="btn btn-info">Details</a>
                                <a href="/admin/actor/Edit?id=@item.Id" type="button" class="btn btn-warning">Edit</a>
                                <a href="/admin/actor/Delete/@item.Id"
                                   class="btn btn-danger btn-delete"
                                   data-id="@item.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @*  pagination  *@
    <div class="row">
        <div class="col-12 d-flex justify-content-center">
            <nav aria-label="Page navigation example">
                <ul class="pagination">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index"
                               asp-route-catogeryName="@ViewBag.actorfristName "
                               asp-route-catogeryName="@ViewBag.actorlastName "
                               asp-route-page="@(ViewBag.CurrentPage-1)"
                               })">Previous</a>
                        </li>
                    }
                    @for (var i = 1; i <= ViewBag.totallnmberofpage; i++)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new {
                                 firstName =  ViewBag.actorfristName,
                                 lastName =  ViewBag.actorlasttName,


                                page = i
                                })">@i</a>
                        </li>
                    }
                    @if (ViewBag.CurrentPage != ViewBag.TotallNumberOfPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index"
                               asp-route-fristName="@ViewBag.actorfristName"
                               asp-route-lasttName="@ViewBag.actorlastName"
                               asp-route-page="@(ViewBag.CurrentPage+1)"
                               })">Nexte</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll('.btn-delete');

        deleteButtons.forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();

                const deleteUrl = this.getAttribute('href');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = deleteUrl;
                    }
                });
            });
        });
    });
</script>




