@model IEnumerable<Cinema>
@section Scripts {

    @if (@TempData["successfull notification"] is not null)
    {
        <script>
            toastr.success('@TempData["successfull notification"]')
        </script>
    }
    else if (TempData["successfull notification"] is not null)
    {
        <script>
            toastr.success('@TempData["successfull notification"]')
        </script>
    }
}


<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">All cinemas</h2>
        </div>
        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
            <a href="/admin/cinema/Create" class="btn btn-success">Create</a>
        </div>
    </div>
    <!-- Filter Section -->
    <section class="py-3 filter-bar">
        <div class="container">
            <div class="row" style="background-color: rgba(var(--bs-light-rgb), var(--bs-bg-opacity)) !important;">
                <div class="col-12">
                    <form>
                        <div class="row">
                            <!-- movies Name -->
                            <div class="col-md-3">
                                <input type="text" class="form-control" placeholder="Cinema Name" name="CinemaName" value="@ViewBag.cinemaName">
                            </div>

                            <!--  Address -->
                            <div class="col-md-3">
                                <input type="text" class="form-control" placeholder="Address" name="Address" value="@ViewBag.addresse">
                            </div>

                            <!-- Submit Button -->
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-dark w-100">Filter</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>


    <div class="row">
        <div class="col-12">

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Name</th>

                        <th scope="col">description</th>
                        <th scope="col">address</th>



                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.Name</td>

                            @if(item.Description is not null && item.Description.Length > 40)
                            {
                                <td>@item.Description.Substring(0,40)</td>
                            }
                            else
                            {
                                <td>@item.Description</td>
                            }
                            <td>@item.Address</td>
                          


                            <td>
                                <a href="/movies/Home/Details/@item.Id" type="button" class="btn btn-info">Details</a>
                                <a href="/admin/cinema/Edit?id=@item.Id" type="button" class="btn btn-warning">Edit</a>
                                <a href="/admin/cinema/Delete/@item.Id"
                                   class="btn btn-danger btn-delete"
                                   data-id="@item.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
      @*  pagination  *@
    <div class="row">
        <div class="col-12 d-flex justify-content-center">
            <nav aria-label="Page navigation example">
                <ul class="pagination">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index"
                               asp-route-CineaName="@ViewBag.cinemaName"
                               asp-route-address="@ViewBag.address"
                               asp-route-page="@(ViewBag.CurrentPage-1)"
                               })">Previous</a>
                        </li>
                    }
                    @for (var i = 1; i <= ViewBag.TotallNumberOfPage; i++)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new {
                                 CinemaName =ViewBag.cinemaName,
                                MinPrice = ViewBag.address,
                                page = i
                                })">@i</a>
                        </li>
                    }
                    @if (ViewBag.CurrentPage != ViewBag.TotallNumberOfPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index"
                               asp-route-CineaName="@ViewBag.cinemaName"
                               asp-route-address="@ViewBag.address"
                               asp-route-page="@(ViewBag.CurrentPage+1)"
                               })">Nexst</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll('.btn-delete');

        deleteButtons.forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();

                const deleteUrl = this.getAttribute('href');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = deleteUrl;
                    }
                });
            });
        });
    });
</script>




